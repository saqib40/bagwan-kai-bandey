    "routes": "node scripts/dump-routes.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
