{
  "name": "bagwan-kai-bandey",
  "version": "0.3.0",
  "description": "Bagwan Kai Bandey (BKB): graph-governed codebase migration engine powered by FalkorDB.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/types.ts",
    "./pack": "./src/engine/packLoader.ts"
  },
  "bin": {
    "bkb": "bin/bkb.js",
    "shift": "bin/bkb.js"
  },
  "files": [
    "bin",
    "src",
    "packs",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "bkb": "node ./bin/bkb.js",
    "shift": "node ./bin/bkb.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "validate:queries": "tsx scripts/validate-queries.ts",
    "validate:cypher": "tsx scripts/validate-cypher.ts",
    "benchmark": "tsx scripts/benchmark-scale.ts",
    "demo": "tsx src/server/demoServer.ts",
    "start": "node ./bin/bkb.js",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "falkordb",
    "graph",
    "codebase-migration",
    "mcp",
    "model-context-protocol",
    "refactoring",
    "fastify",
    "express",
    "ast",
    "strangler-fig"
  ],
  "author": "Saqib Hussain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saqib40/bagwan-kai-bandey.git"
  },
  "bugs": {
    "url": "https://github.com/saqib40/bagwan-kai-bandey/issues"
  },
  "homepage": "https://github.com/saqib40/bagwan-kai-bandey#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.20.0",
    "falkordb": "^6.0.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "web-tree-sitter": "^0.25.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
